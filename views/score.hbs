{{!--
  The halo: the resolved records' own covers, turning slowly. This is the only
  colour on the page by design (.impeccable.md §3), which is exactly why it is
  absent rather than approximated when there is no artwork — old scores,
  art-less releases, the key-death degraded mode all render an empty array and
  the page simply starts at its title. Decorative and inert: aria-hidden, no
  pointer events, fixed height so late covers shift nothing.
--}}
{{#if score.artwork.length}}
  <div class="halo" aria-hidden="true" style="--n: {{score.artwork.length}}">
    <div class="halo-ring">
      {{#each score.artwork}}
        <div class="halo-tile" style="--i: {{@index}}">
          <img src="{{this}}" alt="" width="112" height="112" loading="lazy" decoding="async" />
        </div>
      {{/each}}
    </div>
  </div>
{{/if}}

<article id="score" data-slug="{{score.slug}}">
  <header class="score-head">
    <h1>{{score.title}}</h1>
    {{! The model's reading of the scent — never the visitor's raw words. }}
    <p class="interpretation">{{score.interpretation}}</p>
    <p class="meta">
      {{#if score.durationLabel}}{{score.durationLabel}}{{/if}}
      {{#if score.discoveryLabel}} &middot; {{score.discoveryLabel}}{{/if}}
      {{#if score.runtimeLabel}} &middot; {{score.runtimeLabel}} of music{{/if}}
      &middot; {{score.trackCount}} tracks
    </p>
  </header>

  {{! Arc bar: widths come from the phase weights, precomputed as percentages.
      The share is stated in words and figures as well as width and tone. The
      data-* pair is what the share card reads to redraw the arc on canvas. }}
  <ol class="arc" aria-label="The scent's evolution across the playlist">
    {{#each score.arc}}
      <li class="arc-segment arc-{{name}}" data-name="{{name}}" data-pct="{{pct}}" style="width: {{pct}}%">
        <span class="arc-swatch" aria-hidden="true"></span>
        <span class="arc-label"><span class="arc-name">{{name}}</span><span class="arc-pct">{{pct}}%</span></span>
      </li>
    {{/each}}
  </ol>

  <p class="arc-caption">
    Top notes open the room. Heart notes give it feeling. Base notes decide what stays.
  </p>

  {{#if score.short}}
    <p class="note">
      This score came out shorter than usual{{#unless score.runtimeShort}} &mdash; a few records couldn&rsquo;t be found{{/unless}}.
    </p>
  {{/if}}

  {{#each score.phases}}
    <section class="phase phase-{{name}}">
      <div class="phase-head">
        <p class="phase-eyebrow">{{name}} notes</p>
        <h2>{{label}}</h2>
        <p class="scent-notes">{{scentNotes}}</p>
      </div>

      <ol class="tracks">
        {{#each tracks}}
          <li class="track{{#if indie}} indie{{/if}}">
            <div class="track-head">
              <p class="track-name"><span class="track-title">{{title}}</span>{{#if indie}}<span class="indie-find">indie find</span>{{/if}}</p>
              <p class="track-artist">{{artist}}</p>
              <p class="why">{{why}}</p>
            </div>
            <div class="track-embed">
              <iframe
                src="{{embedUrl}}?theme=0"
                width="100%"
                height="152"
                loading="lazy"
                title="{{title}} by {{artist}}"
                allow="encrypted-media; clipboard-write; fullscreen; picture-in-picture"
              ></iframe>
            </div>
          </li>
        {{/each}}
      </ol>
    </section>
  {{/each}}

  <footer class="actions">
    <div class="action-row">
      <button type="button" id="copy-link" data-url="/score/{{score.slug}}" class="button-quiet">Copy link</button>
      <button type="button" id="remix" data-slug="{{score.slug}}" class="button-quiet">Remix</button>
    </div>
    <p id="action-status" hidden aria-live="polite"></p>

    {{!--
      The share kit. A score is an artifact, not a session: it has an address,
      a code you can tape next to the candle, and a card that carries the
      reasoning into a message thread. Both are made in the browser — no API,
      no tracking, nothing leaves the page. The plate stays hidden until the
      encoder has actually drawn something; an empty frame reads as broken.
    --}}
    <section class="share" id="share" aria-labelledby="share-heading">
      <figure class="qr-plate" id="qr-plate" hidden>
        <canvas id="qr-canvas"></canvas>
        <figcaption>scan to open</figcaption>
      </figure>
      <div class="share-copy">
        <p class="share-eyebrow" id="share-heading">Take it with you</p>
        <p class="share-note">
          This score keeps its address. Point a phone at the code, or save the card
          and drop it wherever you were going to describe this out loud.
        </p>
        <div class="action-row">
          <button type="button" id="save-card" class="button-quiet">Save as card</button>
        </div>
      </div>
    </section>

    <p class="closer"><a href="/">Keep the room going.</a></p>
  </footer>
</article>
