{{!--
  Restraint is the first impression: a headline, the premise, one card with one
  question, two dials and one button. Nothing else on the page.
--}}
<div class="home-intro">
  <h1 class="headline">Describe what&rsquo;s in the air.</h1>
  <p class="prose premise">
    <span>Top notes open the room.</span>
    <span>Heart notes give it feeling.</span>
    <span>Base notes decide what stays.</span>
  </p>
</div>

<form id="score-form" class="card" method="post" action="/api/score">
  <div class="field">
    <label for="scent">What does it smell like?</label>
    <textarea
      id="scent"
      name="input"
      rows="3"
      maxlength="{{maxLength}}"
      required
      placeholder="bergamot, black tea, cedar &mdash; a quiet bookshop on a rainy day"
    ></textarea>
    <span class="hint">Fragrance notes, a candle label, coffee-bag tasting notes &mdash; any scent language works.</span>
  </div>

  <fieldset class="pill-set">
    <legend>How long?</legend>
    <div class="pills">
      {{#each durations}}
        <label class="pill">
          <input type="radio" name="duration" value="{{value}}" {{#if checked}}checked{{/if}} />
          <span>{{label}}</span>
        </label>
      {{/each}}
    </div>
  </fieldset>

  <fieldset class="pill-set">
    <legend>Discovery</legend>
    <div class="pills">
      {{#each discoveries}}
        <label class="pill">
          <input type="radio" name="discovery" value="{{value}}" {{#if checked}}checked{{/if}} />
          <span>{{label}}</span>
        </label>
      {{/each}}
    </div>
  </fieldset>

  <button type="submit" id="submit" class="cta">Distill my playlist</button>
</form>

<p id="examples">
  <span class="ex-label">or try an example:</span>
  {{!-- kept on one line so no stray whitespace lands beside the separators --}}
  <a href="/score/ember-and-hide-dq10b9" class="example">Smoky oud</a><span class="sep" aria-hidden="true">&middot;</span><a href="/score/cortado-hours-animoa" class="example">Espresso beans</a><span class="sep" aria-hidden="true">&middot;</span><a href="/score/salt-air-clean-line-u4giy2" class="example">Ocean soap</a>
</p>

{{!--
  The wait is real — up to two minutes for a 90-minute or deep-cuts score — so
  the state says so instead of pretending. Line one is the anchor, line two is
  written from the pills before the request leaves, line three crossfades
  through what is actually happening. Both are filled by public/js/home.js,
  which is where this page's copy already lives.
--}}
<div id="loading" hidden aria-live="polite">
  <p class="loading-anchor">distilling your scent&hellip;</p>
  <p class="loading-wait"></p>
  <p class="loading-step"></p>
</div>
<p id="error" hidden role="alert"></p>
