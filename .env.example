# Vibin' Out v2 — the Drydown Score.
# Copy to .env for local development. SESSION_SECRET is gone: v2 has no auth.

# Mongo. Stores score documents and rate-limit counters.
# Rate limiting fails CLOSED, so generation refuses while this is unreachable.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/playlistdb?retryWrites=true&w=majority

# LLM. Production uses ANTHROPIC_API_KEY set directly (the Vercel AI Gateway
# requires a credit card on file, so it isn't the default). Set an explicit
# key here for local dev too. AI_GATEWAY_API_KEY, if set, wins over
# ANTHROPIC_API_KEY; with neither set, bare OIDC on Vercel falls back to the
# gateway.
ANTHROPIC_API_KEY=
# AI_GATEWAY_API_KEY=

# Spotify client credentials — search and embeds only, no user OAuth.
CLIENT_ID=
CLIENT_SECRET=

# ListenBrainz LB Radio — the deep-cuts discovery provider. OFF by default,
# and off is a fully supported state: with these unset, "deep cuts" works
# exactly as it always has (the model names the records itself).
#
# Turning it on needs BOTH variables. The endpoint
# (https://api.listenbrainz.org/1/explore/lb-radio) is credential-gated —
# every call without a token is 401, and a bogus token is 401 too:
#   1. Make a free account at https://listenbrainz.org
#   2. Settings → user token → copy the UUID → LB_TOKEN
#   3. LB_RADIO=deepcuts
# Any other value of LB_RADIO (including "off" and unset) leaves it inert, and
# familiar/balanced never touch it whatever these say. Every provider failure
# — bad token, timeout, thin results — falls back silently to the model's own
# track choices, so a dead token degrades quality, never availability.
# LB_RADIO=deepcuts
# LB_TOKEN=

# Local server port only; unused on Vercel.
PORT=3000
