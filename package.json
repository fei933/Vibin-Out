{
  "name": "vibin-out",
  "version": "2.0.0",
  "description": "Turn a scent into a soundtrack — the Drydown Score.",
  "private": true,
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "test": "node --test",
    "test:e2e": "node scripts/e2e.mjs",
    "check:photo": "env -u ANTHROPIC_API_KEY node scripts/photo-check.mjs",
    "fixture:photo": "node scripts/make-fixture-photo.mjs",
    "eval": "env -u ANTHROPIC_API_KEY node --env-file=.env scripts/eval.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.103",
    "ai": "^6.0.0",
    "dotenv": "^17.0.0",
    "express": "^4.21.2",
    "hbs": "^4.2.0",
    "mongoose": "^8.9.0",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": "22.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fei933/Vibin-Out.git"
  },
  "license": "ISC",
  "devDependencies": {
    "playwright": "^1.62.0"
  }
}
